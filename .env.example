# Gemini API (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeatherMap (https://openweathermap.org, 免费层)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# 数据库路径
DATABASE_URL=sqlite:///./data/concord.db
CHROMA_DB_PATH=./data/chroma_db
KNOWLEDGEBASE_PATH=./

# 路由配置
MAX_CONSECUTIVE_SPEAKS=2
AUTO_MODE_INTERVAL=15
GEMINI_TIMEOUT=15
GEMINI_MAX_RETRIES=2

# RAG 配置
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# 开发模式 (true 时开启路由权重 debug 广播)
DEBUG=false

# ElevenLabs text-to-speech (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_VOICE_AGENT_PRISON=CwhRBWXzGAHq8TQ4Fs17
ELEVENLABS_VOICE_AGENT_DEVELOPER=IKne3meq5aSn9XLyUdCD
